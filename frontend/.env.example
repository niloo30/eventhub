# Frontend deployment variables.
# For Nginx/reverse-proxy deployments, keep API/socket blank and use same origin.
VITE_API_URL=
VITE_SOCKET_URL=
VITE_USE_SAME_ORIGIN=true

# For split deployments, disable same-origin and use your deployed backend origin.
# VITE_API_URL=https://your-backend-name.onrender.com
# VITE_SOCKET_URL=https://your-backend-name.onrender.com
# VITE_USE_SAME_ORIGIN=false
