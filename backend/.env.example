# Render deployment variables
# Set CLIENT_URL to your Vercel production URL.
# Add your preview URL pattern too if you want Vercel preview deployments to work.

NODE_ENV=production
PORT=5050
MONGO_URI=mongodb://localhost:27017/event_mgmt
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URLS=https://your-frontend.vercel.app,https://*.vercel.app

AUTH_OTP_EXPIRES_IN_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
TICKET_HOLD_MINUTES=8

# HTTP REST Email API Options (Recommended for Serverless/Production)
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
EMAIL_API_URL=
EMAIL_API_KEY=

# SMTP Options
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use a separate webhook secret if Razorpay dashboard provides one.
RAZORPAY_WEBHOOK_SECRET=

# Optional Redis seat-lock layer. Leave blank to fall back to Mongo-only
# protection during local development.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=event-manager
